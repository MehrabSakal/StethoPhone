<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/analysisToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="Sound Diagnostics &amp; ML"
            app:subtitle="Spectrogram, PPG &amp; Time-Expanded Wave" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/analysisTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabMode="scrollable"
            app:tabSelectedTextColor="@color/primary"
            app:tabIndicatorColor="@color/primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_marginBottom="72dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Loading indicator -->
            <LinearLayout
                android:id="@+id/layoutLoading"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminateTint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Generating Spectrogram, PPG &amp; ML Metrics…"
                    android:textColor="@color/on_surface_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. ML DISEASE DETECTION FEATURES CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/divider"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="ML Disease Detection Features"
                                android:textColor="@color/on_surface"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvMlBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_clean"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="10x ML READY"
                                android:textColor="@color/badge_clean_text"
                                android:textSize="10.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="12dp"
                            android:background="@color/divider" />

                        <!-- Metric Row 1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Resp. Rate" android:textColor="@color/on_surface_muted" android:textSize="11sp" />
                                <TextView android:id="@+id/tvMetricBpm" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="16.5" android:textColor="@color/on_surface" android:textSize="16sp" android:textStyle="bold" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BPM (PPG)" android:textColor="@color/on_surface_muted" android:textSize="9.5sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dominant Peak" android:textColor="@color/on_surface_muted" android:textSize="11sp" />
                                <TextView android:id="@+id/tvMetricPeakFreq" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="280" android:textColor="@color/on_surface" android:textSize="16sp" android:textStyle="bold" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hz (Spectral)" android:textColor="@color/on_surface_muted" android:textSize="9.5sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SNR Quality" android:textColor="@color/on_surface_muted" android:textSize="11sp" />
                                <TextView android:id="@+id/tvMetricSnr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="32.4" android:textColor="@color/on_surface" android:textSize="16sp" android:textStyle="bold" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="dB (Cleanliness)" android:textColor="@color/on_surface_muted" android:textSize="9.5sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Metric Row 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vesicular Energy" android:textColor="@color/on_surface_muted" android:textSize="11sp" />
                                <TextView android:id="@+id/tvMetricVesicular" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="74.2%" android:textColor="@color/primary" android:textSize="15sp" android:textStyle="bold" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100–1000 Hz" android:textColor="@color/on_surface_muted" android:textSize="9.5sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bronchial Energy" android:textColor="@color/on_surface_muted" android:textSize="11sp" />
                                <TextView android:id="@+id/tvMetricBronchial" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="23.8%" android:textColor="@color/secondary" android:textSize="15sp" android:textStyle="bold" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1000–2000 Hz" android:textColor="@color/on_surface_muted" android:textSize="9.5sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gain Boost" android:textColor="@color/on_surface_muted" android:textSize="11sp" />
                                <TextView android:id="@+id/tvMetricGain" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10.0x" android:textColor="@color/secondary" android:textSize="15sp" android:textStyle="bold" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+20 dB Normalized" android:textColor="@color/on_surface_muted" android:textSize="9.5sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. SPECTROGRAM HEATMAP CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSpectrogram"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/divider"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Spectrogram Heatmap (STFT 0 – 2.5 kHz)"
                            android:textColor="@color/on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Reveals musical wheezes (horizontal tracks) and crackles (vertical spikes)."
                            android:textColor="@color/on_surface_muted"
                            android:textSize="11sp" />

                        <com.respiratory.lungaudio.ui.SpectrogramView
                            android:id="@+id/spectrogramView"
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:layout_marginTop="12dp"
                            android:background="#0B1120" />

                        <TextView
                            android:id="@+id/tvSpectrogramTimeScale"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0.0s ────────────────────────────── 4.0s"
                            android:textColor="@color/on_surface_muted"
                            android:textSize="10sp"
                            android:fontFamily="monospace" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. PHONOPNEUMOGRAM (PPG) CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPpg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/divider"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Phonopneumogram (Acoustic Respiratory PPG)"
                            android:textColor="@color/on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Acoustic volume envelope with detected inhalation and exhalation breath peaks."
                            android:textColor="@color/on_surface_muted"
                            android:textSize="11sp" />

                        <com.respiratory.lungaudio.ui.PhonopneumogramView
                            android:id="@+id/ppgView"
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:id="@+id/tvPpgTimeScale"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0.0s ────────────────────────────── 4.0s"
                            android:textColor="@color/on_surface_muted"
                            android:textSize="10sp"
                            android:fontFamily="monospace" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. TIME-EXPANDED WAVEFORM CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardWaveform"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/divider"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Time-Expanded Waveform"
                            android:textColor="@color/on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="High-definition oscillogram showing exact acoustic amplitude oscillations."
                            android:textColor="@color/on_surface_muted"
                            android:textSize="11sp" />

                        <com.respiratory.lungaudio.ui.TimeExpandedWaveformView
                            android:id="@+id/waveformView"
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:id="@+id/tvWaveformTimeScale"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0.0s ────────────────────────────── 4.0s"
                            android:textColor="@color/on_surface_muted"
                            android:textSize="10sp"
                            android:fontFamily="monospace" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- PINNED BOTTOM AUDIO PLAYBACK BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:background="@color/surface"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnalysisPlayPause"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:icon="@drawable/ic_play"
            app:iconSize="24dp"
            app:backgroundTint="@color/primary" />

        <SeekBar
            android:id="@+id/seekAnalysisPlayer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:max="100" />

        <TextView
            android:id="@+id/tvAnalysisTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00 / 00:00"
            android:textColor="@color/on_surface"
            android:textSize="11.5sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
