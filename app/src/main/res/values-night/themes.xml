<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.LungSoundRecorder" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">#26A69A</item>
        <item name="colorOnPrimary">#00382E</item>
        <item name="colorPrimaryContainer">#005043</item>
        <item name="colorOnPrimaryContainer">#80CBC4</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">#7986CB</item>
        <item name="colorOnSecondary">#1A237E</item>
        <item name="colorSecondaryContainer">#283593</item>
        <item name="colorOnSecondaryContainer">#C5CAE9</item>

        <!-- Status bar and navigation bar -->
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/background_dark</item>

        <!-- Background colors -->
        <item name="android:colorBackground">@color/background_dark</item>
    </style>
</resources>
